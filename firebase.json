{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".gitignore",
      ".env*",
      ".vercel/**",
      "**/node_modules/**",
      "functions/**",
      "vercel.json",
      "package.json",
      "package-lock.json",
      "CLAUDE.md",
      "PROGRESS.md",
      "reference/**",
      "temp/**",
      "assets-source/**",
      "store-assets/**",
      "scratch_docx_extract/**",
      "image.png",
      "image copy.png",
      "image copy 2.png"
    ],
    "rewrites": [
      { "source": "/api/generate-variations", "function": { "functionId": "generateVariations", "region": "asia-northeast3" } },
      { "source": "/api/ai-variation-usage", "function": { "functionId": "aiVariationUsage", "region": "asia-northeast3" } }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
